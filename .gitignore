# EnergyPlus outputs
eplusout.*

# Test outputs
test_*/

# Python
__pycache__/
*.pyc
*.pyo
*.pyc

# Results (large data)
results/

# Code coverage
.coverage
htmlcov/

# Node deps (vfed-web)
node_modules/

# Cached weather (regeneratable via fetch_weather)
weather_cache/

# UX persona test sandbox (user-gym)
user-gym/

# Local gadget projects (promo / animation / games / 3d-studio)
gadget/

# Local scratchpads (no longer tracked; history kept)
.scratchpad/

# IDE / tooling
.pytest_cache/
*.code-workspace

# research/: keep sources (.py/.ipynb/.idf/.json) tracked,
# ignore heavy EnergyPlus outputs (local copies retained)
research/**/*.html
research/**/*.png
research/**/*.csv
research/**/*.epw
research/**/*.zip
research/**/*.xlsm
