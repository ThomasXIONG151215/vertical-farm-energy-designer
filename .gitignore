# EnergyPlus outputs
eplusout.*

# Test outputs
test_*/

# Python
__pycache__/
*.pyc
*.pyo
*.pyc

# Results (large data)
results/

# Code coverage
.coverage
htmlcov/

# Node deps (vfed-web)
node_modules/

# Cached weather (regeneratable via fetch_weather)
weather_cache/

# UX persona test sandbox (user-gym)
user-gym/

# Local gadget projects (promo / animation / games / 3d-studio)
gadget/

# Local scratchpads (no longer tracked; history kept)
.scratchpad/

# IDE / tooling
.pytest_cache/
*.code-workspace

# research/: keep sources (.py/.ipynb/.idf/.json) tracked,
# ignore heavy EnergyPlus outputs (local copies retained)
research/**/*.html
research/**/*.png
research/**/*.csv
research/**/*.epw
research/**/*.zip
research/**/*.xlsm

# External datasets (2026-10-11): raw data files are regeneratable from
# upstream sources (see data/植物工厂运行数据资源清单.md), only track the
# per-dataset documentation files (数据说明.md)
data/datasets/**
!data/datasets/**/
!data/datasets/**/*.md

# NREL SAM module libraries (2026-11-01): 6.3 MB / 195 KB CSVs regeneratable
# from the SAM GitHub develop branch; source URL recorded in
# reference/pvbes-validation/readme.md (do not track the bulk data)
reference/pvbes-validation/raw/cec_modules.csv
reference/pvbes-validation/raw/sandia_modules.csv

# Original UC Davis archive (unpacked copy lives in data/datasets/)
data/Lettuce_growth.zip

# EnergyPlus benchmark outputs (regeneratable: run_energyplus.py / build_idf.py)
scripts/benchmarks/bestest/energyplus/out*/

# Browser frontend (moved to local backups/ on 2026-10-23, removed from public repo)
vfed-web/
# Local backups (never tracked)
backups/
# vendor datasheet PDFs (large, redistributable-on-request; extraction results live in modules/*.yaml)
reference/pvbes-validation/raw/datasheets/
